<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_category_rice_mill" model="product.category">
        <field name="name">Rice Mill</field>
    </record>

    <record id="product_paddy" model="product.product">
        <field name="name">Paddy (Mpunga)</field>
        <field name="default_code">MPUNGA</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="tracking">lot</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="categ_id" ref="product_category_rice_mill"/>
        <field name="cl_rice_product">paddy</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="True"/>
    </record>
