<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cl_rice_mill.FarmerSeasonPanel">
        <div class="o_cl_rice_fs_panel w-100">
            <t t-if="this.state.data">
                <t t-set="data" t-value="this.state.data"/>
                <div class="row g-3">
                    <div class="col-12 col-md-4 text-center">
                        <h6>Balance and credit limit</h6>
                        <ChartCard config="this.gaugeConfig()" height="140"/>
                        <div class="fs-5 fw-bold" t-out="this.money(data.balance)"/>
                        <div class="small text-muted">owed, of a limit of <t t-out="this.money(data.limit)"/></div>
                        <div class="small" t-if="data.funds">Held for the farmer: <b t-out="this.money(data.funds)"/></div>
                    </div>
                    <div class="col-12 col-md-4 text-center">
                        <h6>Charges this season</h6>
                        <t t-if="data.charges.length">
                            <ChartCard config="this.chargesConfig()" height="200"/>
                        </t>
                        <div t-else="" class="text-muted py-4">No charges yet.</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <h6>Stock and collateral</h6>
                        <div class="fs-5 fw-bold"><t t-out="this.number(data.stock_kg)"/> kg in store</div>
                        <table class="table table-sm small" t-if="data.stock.length">
                            <tbody>
                                <tr t-foreach="data.stock" t-as="line" t-key="line.lot">
                                    <td t-out="line.product"/><td class="small" t-out="line.lot"/>
                                    <td class="text-end" t-out="this.number(line.kg) + ' kg'"/>
                                    <td class="text-end" t-out="this.number(line.bags, 1) + ' bags'"/>
                                </tr>
                            </tbody>
                        </table>
                        <div>Collateral cover: <b t-att-class="this.coverClass()" t-out="data.balance ? this.number(data.cover, 1) + '%' : '-'"/></div>
                    </div>
                </div>
                <h6 class="mt-3">Latest activity</h6>
                <ul class="list-group list-group-flush" t-if="data.timeline.length">
                    <li class="list-group-item d-flex gap-2 px-0" t-foreach="data.timeline" t-as="event" t-key="event_index">
                        <i t-attf-class="fa {{ event.icon }} fa-fw mt-1 text-primary"/>
                        <div class="flex-grow-1">
                            <div t-out="event.title"/>
                            <div class="small text-muted" t-out="event.date"/>
                        </div>
                        <div class="small fw-bold" t-if="event.amount" t-out="this.money(event.amount)"/>
                    </li>
                </ul>
                <div t-else="" class="text-muted">Nothing yet.</div>
            </t>
        </div>
    </t>
</templates>
