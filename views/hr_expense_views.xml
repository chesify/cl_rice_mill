<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">hr.expense.view.form.inherit.cl.rice.mill</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='product_id']" position="after">
                <field name="cl_vehicle_id" groups="cl_rice_mill.cl_rice_mill_group_user"/>
                <field name="cl_farmer_season_id" groups="cl_rice_mill.cl_rice_mill_group_user"/>
            </xpath>
        </field>
    </record>

    <record id="cl_rice_expense_action" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">hr.expense</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a small expense</p>
            <p>Fuel bought on the road, spare parts, airtime, bags... Choose the machine or vehicle it was for.</p>
        </field>
    </record>
</odoo>
