<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_farmer_group_view_list" model="ir.ui.view">
        <field name="name">cl.rice.farmer.group.view.list</field>
        <field name="model">cl.rice.farmer.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="leader_id"/>
                <field name="village"/>
                <field name="member_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cl_rice_farmer_group_view_form" model="ir.ui.view">
        <field name="name">cl.rice.farmer.group.view.form</field>
        <field name="model">cl.rice.farmer.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Kikundi cha Umoja"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="leader_id"/>
                            <field name="village"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids" readonly="1">
                                <list>
                                    <field name="cl_farmer_code"/>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="cl_village"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cl_rice_farmer_group_action" model="ir.actions.act_window">
        <field name="name">Farmer Groups</field>
        <field name="res_model">cl.rice.farmer.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
