<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_report_cash_book_view_list" model="ir.ui.view">
        <field name="name">cl.rice.report.cash.book.view.list</field>
        <field name="model">cl.rice.report.cash.book</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="money_in" sum="Total"/>
                <field name="money_out" sum="Total"/>
                <field name="net" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="cl_rice_report_cash_book_view_pivot" model="ir.ui.view">
        <field name="name">cl.rice.report.cash.book.view.pivot</field>
        <field name="model">cl.rice.report.cash.book</field>
        <field name="arch" type="xml">
            <pivot string="Cash Book" disable_linking="1">
                <field name="date" interval="day" type="row"/>
                <field name="journal_id" type="col"/>
                <field name="money_in" type="measure"/>
                <field name="money_out" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="cl_rice_report_cash_book_view_search" model="ir.ui.view">
        <field name="name">cl.rice.report.cash.book.view.search</field>
        <field name="model">cl.rice.report.cash.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                    <filter name="group_journal" string="Cash / Bank / Mobile Money" context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cl_rice_report_cash_book_action" model="ir.actions.act_window">
        <field name="name">Cash Book</field>
        <field name="res_model">cl.rice.report.cash.book</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_group_date': 1, 'search_default_group_journal': 1}</field>
        <field name="help" type="html">
            <p>Money in and money out, per day and per cash, bank or mobile money account.</p>
        </field>
    </record>
</odoo>
