<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_facilitated_sale_view_list" model="ir.ui.view">
        <field name="name">cl.rice.facilitated.sale.view.list</field>
        <field name="model">cl.rice.facilitated.sale</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="buyer_id"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="quantity" sum="Total"/>
                <field name="released_qty" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total" optional="show"/>
                <field name="payment_route"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state in ('cleared', 'released')" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="cl_rice_facilitated_sale_view_form" model="ir.ui.view">
        <field name="name">cl.rice.facilitated.sale.view.form</field>
        <field name="model">cl.rice.facilitated.sale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_new_release" type="object" string="Release Stock" class="btn-primary"
                            invisible="state in ('done', 'cancelled')"
                            groups="cl_rice_mill.cl_rice_mill_group_warehouse,cl_rice_mill.cl_rice_mill_group_accountant"/>
                    <button name="action_receive_buyer_payment" type="object" string="Receive Payment"
                            invisible="payment_route != 'luvanda' or state in ('done', 'cancelled')"
                            groups="cl_rice_mill.cl_rice_mill_group_accountant"/>
                    <button name="action_done" type="object" string="Close Sale" invisible="state not in ('released',)"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,cleared,released,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_releases" type="object" class="oe_stat_button" icon="fa-truck"
                                string="Releases"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Farmer and Buyer" name="parties">
                            <field name="farmer_season_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="buyer_id" readonly="state in ('done', 'cancelled')"/>
                            <field name="date"/>
                            <field name="payment_route" widget="radio" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Goods" name="goods">
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="lot_id" readonly="state != 'draft'"/>
                            <field name="available_qty"/>
                            <field name="quantity" readonly="state in ('done', 'cancelled')"/>
                            <field name="bags" readonly="state in ('done', 'cancelled')"/>
                            <field name="released_qty"/>
                            <field name="remaining_qty"/>
                        </group>
                    </group>
                    <group>
                        <group string="Price (reference only)" name="price">
                            <field name="currency_id" invisible="1"/>
                            <field name="price_unit"/>
                            <field name="amount"/>
                            <field name="buyer_paid" invisible="payment_route != 'luvanda'"/>
                        </group>
                        <group string="Transport" name="transport">
                            <field name="vehicle_plate"/>
                            <field name="driver_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Releases" name="releases">
                            <field name="release_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="bags" sum="Total"/>
                                    <field name="vehicle_plate"/>
                                    <field name="clearance_basis"/>
                                    <field name="cleared_uid"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Buyer Payments" name="payments" invisible="payment_route != 'luvanda'">
                            <field name="payment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="journal_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cl_rice_facilitated_sale_view_search" model="ir.ui.view">
        <field name="name">cl.rice.facilitated.sale.view.search</field>
        <field name="model">cl.rice.facilitated.sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="buyer_id"/>
                <field name="lot_id"/>
                <filter name="open" string="Open" domain="[('state', 'not in', ('done', 'cancelled'))]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_buyer" string="Buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cl_rice_facilitated_sale_action" model="ir.actions.act_window">
        <field name="name">Sales and Releases</field>
        <field name="res_model">cl.rice.facilitated.sale</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a farmer's sale to a buyer</p>
            <p>The farmer sells his own crop. The mill only releases the stock, once the farmer's balance allows it.</p>
        </field>
    </record>
</odoo>
