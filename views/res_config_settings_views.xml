<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cl.rice.mill</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Rice Mill" string="Rice Mill" name="cl_rice_mill" logo="/cl_rice_mill/static/description/icon.png">
                    <block title="Setup" name="cl_rice_setup_container">
                        <setting id="cl_rice_setup" string="Accounts and Journals"
                                 help="Create the rice mill accounts, journals and stock setup this company still misses.">
                            <button name="action_cl_rice_setup_company" type="object" string="Set up Rice Mill"
                                    class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                    </block>
                    <block title="Loans and Interest" name="cl_rice_loans_container">
                        <setting id="cl_rice_interest" string="Interest" help="How interest is charged on farmer loans.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_interest_mode" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_interest_mode"/>
                                </div>
                                <div class="row" invisible="cl_rice_interest_mode == 'none'">
                                    <label for="cl_rice_interest_rate" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_interest_rate"/>
                                </div>
                                <div class="row" invisible="cl_rice_interest_mode != 'monthly'">
                                    <label for="cl_rice_interest_accrual" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_interest_accrual"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_credit" string="Credit Limit"
                                 help="Acreage x expected yield x reference price x loan-to-value.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_default_yield" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_default_yield"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_ltv_percent" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_ltv_percent"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_min_cover_percent" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_min_cover_percent"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Sales" name="cl_rice_sales_container">
                        <setting id="cl_rice_sales_mode" string="Sales Mode"
                                 help="Agent: the mill sells on behalf of the farmer for a commission. Owner: the mill buys the crop, then resells it.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <field name="cl_rice_sales_mode" widget="radio" class="col-lg-12"/>
                                </div>
                                <div class="row" invisible="cl_rice_sales_mode != 'agent'">
                                    <label for="cl_rice_commission_type" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_commission_type"/>
                                </div>
                                <div class="row" invisible="cl_rice_sales_mode != 'agent'">
                                    <label for="cl_rice_commission_value" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_commission_value"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_byproducts" string="By-products"
                                 help="Who gets the by-products of milling, and the credit per kg given to the farmer when the mill keeps them.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_bran_policy" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_bran_policy"/>
                                </div>
                                <div class="row" invisible="cl_rice_bran_policy != 'kept'">
                                    <label for="cl_rice_bran_value" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_bran_value"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_husk_policy" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_husk_policy"/>
                                </div>
                                <div class="row" invisible="cl_rice_husk_policy != 'kept'">
                                    <label for="cl_rice_husk_value" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_husk_value"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_broken_policy" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_broken_policy"/>
                                </div>
                                <div class="row" invisible="cl_rice_broken_policy != 'kept'">
                                    <label for="cl_rice_broken_value" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_broken_value"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Storage and Milling" name="cl_rice_storage_container">
                        <setting id="cl_rice_storage" string="Storage Fees"
                                 help="Monthly storage fee charged on farmer stock after the free period.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_storage_basis" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_storage_basis"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_storage_rate" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_storage_rate"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_storage_free_days" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_storage_free_days"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_paddy_bag_kg" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_paddy_bag_kg"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_rice_bag_kg" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_rice_bag_kg"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_cost_split" string="Milling Cost Split"
                                 help="Relative value per kg of each output, used to split the cost of mill-owned paddy over the outputs.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_split_rice" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_split_rice"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_split_broken" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_split_broken"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_split_bran" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_split_bran"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_split_husk" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_split_husk"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Warehouses" name="cl_rice_stock_container">
                        <setting id="cl_rice_warehouses" string="Stores and Mill"
                                 help="Paddy store (W1), rice store (W2), the mill location and the milling operations.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_paddy_warehouse_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_paddy_warehouse_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_rice_warehouse_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_rice_warehouse_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_mill_location_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_mill_location_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_consume_type_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_consume_type_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_output_type_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_output_type_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_bag_tare" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_bag_tare"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Accounting" name="cl_rice_accounting_container">
                        <setting id="cl_rice_accounts" string="Farmer Accounts">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_loan_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_loan_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_service_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_service_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_proceeds_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_proceeds_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_clearing_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_clearing_account_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_income_accounts" string="Income Accounts">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_interest_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_interest_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_tractor_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_tractor_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_harvester_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_harvester_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_storage_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_storage_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_milling_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_milling_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_commission_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_commission_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_byproduct_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_byproduct_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_other_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_other_income_account_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_journals" string="Journals">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_charge_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_charge_journal_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_walkin_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_walkin_journal_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_loan_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_loan_journal_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_settlement_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_settlement_journal_id"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="cl_rice_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'cl_rice_mill'}</field>
    </record>
</odoo>
