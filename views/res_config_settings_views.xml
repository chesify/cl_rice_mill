<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cl.rice.mill</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Rice Mill" string="Rice Mill" name="cl_rice_mill" logo="/cl_rice_mill/static/description/icon.png">
                    <block title="Setup" name="cl_rice_setup_container">
                        <setting id="cl_rice_setup" string="Rice Mill Setup"
                                 help="Create the accounts, the cash, bank and mobile money journals and the warehouse partitions.">
                            <button name="action_cl_rice_open_setup" type="object" string="Run Setup"
                                    class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                    </block>
                    <block title="Loans" name="cl_rice_loans_container">
                        <setting id="cl_rice_credit" string="Credit Limit"
                                 help="Acreage x expected yield x reference price x loan-to-value. Loans carry no interest.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_default_yield" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_default_yield"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_ltv_percent" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_ltv_percent"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_min_cover_percent" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_min_cover_percent"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Milling" name="cl_rice_milling_container">
                        <setting id="cl_rice_byproducts" string="By-products"
                                 help="Bran and husk always go to the mill's own stock. Broken rice is configurable.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_byproduct_fee_policy" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_byproduct_fee_policy"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_broken_policy" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_broken_policy"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Storage" name="cl_rice_storage_container">
                        <setting id="cl_rice_storage" string="Storage Fees"
                                 help="Monthly storage fee charged on farmer stock after the free period.">
                            <field name="cl_rice_storage_enabled"/>
                            <div class="content-group" invisible="not cl_rice_storage_enabled">
                                <div class="row mt8">
                                    <label for="cl_rice_storage_basis" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_storage_basis"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_storage_rate" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_storage_rate"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_storage_free_days" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_storage_free_days"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_bags" string="Bags" help="Standard bag weights and the tare deducted at intake.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_paddy_bag_kg" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_paddy_bag_kg"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_rice_bag_kg" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_rice_bag_kg"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_bag_tare" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_bag_tare"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Machine and Field Costs" name="cl_rice_costs_container">
                        <setting id="cl_rice_fuel" string="Fuel"
                                 help="Diesel bills go to Fuel Clearing; each job and trip moves the litres it used to the machine or vehicle.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_fuel_price" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_fuel_price"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_fuel_clearing_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_fuel_clearing_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_machine_cost_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_machine_cost_account_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_operators" string="Operator Wages"
                                 help="Wages earned per job are booked on the machine and owed to the operator until paid.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_operator_wage_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_operator_wage_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_operator_accrual_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_operator_accrual_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_cost_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_cost_journal_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_post_expenses" string="Post Company-Paid Expenses"
                                 help="Post the entry of company-paid expenses as soon as they are approved.">
                            <field name="cl_rice_post_expenses"/>
                        </setting>
                    </block>
                    <block title="Warehouse" name="cl_rice_stock_container">
                        <setting id="cl_rice_warehouse" string="Warehouse Partitions"
                                 help="One warehouse with three partitions; rename the partitions on the locations.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_warehouse_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_warehouse_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_paddy_location_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_paddy_location_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_rice_location_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_rice_location_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_byproduct_location_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_byproduct_location_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_released_location_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_released_location_id"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Accounting" name="cl_rice_accounting_container">
                        <setting id="cl_rice_accounts" string="Farmer Accounts">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_loan_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_loan_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_service_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_service_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_funds_held_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_funds_held_account_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_income_accounts" string="Income Accounts">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_tractor_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_tractor_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_harvester_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_harvester_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_storage_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_storage_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_milling_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_milling_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_byproduct_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_byproduct_income_account_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_other_income_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_other_income_account_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="cl_rice_journals" string="Journals">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="cl_rice_charge_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_charge_journal_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_walkin_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_walkin_journal_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_loan_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_loan_journal_id"/>
                                </div>
                                <div class="row">
                                    <label for="cl_rice_settlement_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="cl_rice_settlement_journal_id"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="cl_rice_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'cl_rice_mill'}</field>
    </record>
</odoo>
