<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_ownership_transfer_view_list" model="ir.ui.view">
        <field name="name">cl.rice.ownership.transfer.view.list</field>
        <field name="model">cl.rice.ownership.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="price_unit"/>
                <field name="amount" sum="Total"/>
                <field name="origin" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="cl_rice_ownership_transfer_view_form" model="ir.ui.view">
        <field name="name">cl.rice.ownership.transfer.view.form</field>
        <field name="model">cl.rice.ownership.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Buy Crop" class="btn-primary"
                            invisible="state != 'draft'" groups="cl_rice_mill.cl_rice_mill_group_accountant"
                            confirm="The crop becomes the mill's property and the farmer is billed. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="farmer_season_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="lot_id" readonly="state != 'draft'"/>
                            <field name="product_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="origin"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="quantity" readonly="state != 'draft'"/>
                            <field name="bags" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_unit" readonly="state != 'draft'"/>
                            <field name="amount" class="fw-bold"/>
                            <field name="bill_id" groups="cl_rice_mill.cl_rice_mill_group_accountant"/>
                        </group>
                    </group>
                    <group invisible="state != 'done'" groups="stock.group_stock_user">
                        <field name="out_picking_id"/>
                        <field name="in_picking_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cl_rice_ownership_transfer_action" model="ir.actions.act_window">
        <field name="name">Crop Bought from Farmers</field>
        <field name="res_model">cl.rice.ownership.transfer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
