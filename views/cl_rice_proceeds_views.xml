<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_proceeds_view_list" model="ir.ui.view">
        <field name="name">cl.rice.proceeds.view.list</field>
        <field name="model">cl.rice.proceeds</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="farmer_season_id" optional="show"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="gross_amount" sum="Total"/>
                <field name="commission_amount" sum="Total"/>
                <field name="net_amount" sum="Total"/>
                <field name="move_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cl_rice_proceeds_view_pivot" model="ir.ui.view">
        <field name="name">cl.rice.proceeds.view.pivot</field>
        <field name="model">cl.rice.proceeds</field>
        <field name="arch" type="xml">
            <pivot string="Farmer Sales">
                <field name="partner_id" type="row"/>
                <field name="gross_amount" type="measure"/>
                <field name="commission_amount" type="measure"/>
                <field name="net_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="cl_rice_proceeds_view_search" model="ir.ui.view">
        <field name="name">cl.rice.proceeds.view.search</field>
        <field name="model">cl.rice.proceeds</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="farmer_season_id"/>
                <field name="invoice_id"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_partner" string="Farmer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cl_rice_proceeds_action" model="ir.actions.act_window">
        <field name="name">Farmer Sale Proceeds</field>
        <field name="res_model">cl.rice.proceeds</field>
        <field name="view_mode">list,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sale on behalf of farmers yet</p>
            <p>Proceeds appear when a buyer invoice with farmer stock is posted (agent mode).</p>
        </field>
    </record>
</odoo>
