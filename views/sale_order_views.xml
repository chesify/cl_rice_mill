<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.cl.rice.mill</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/column[@name='sol_qty']" position="before">
                <field name="cl_farmer_season_id" optional="show" groups="cl_rice_mill.cl_rice_mill_group_user"
                       readonly="state == 'sale'"/>
                <field name="cl_lot_id" optional="show" groups="cl_rice_mill.cl_rice_mill_group_user"
                       readonly="state == 'sale'" invisible="not cl_farmer_season_id"/>
                <field name="cl_sale_mode" optional="hide" groups="cl_rice_mill.cl_rice_mill_group_user"
                       readonly="state == 'sale'" invisible="not cl_farmer_season_id"/>
                <field name="cl_farmer_price" optional="hide" groups="cl_rice_mill.cl_rice_mill_group_user"
                       readonly="state == 'sale'" invisible="cl_sale_mode != 'owner'"/>
                <field name="cl_bags" optional="hide" groups="cl_rice_mill.cl_rice_mill_group_user"
                       invisible="not cl_farmer_season_id"/>
            </xpath>
        </field>
    </record>
</odoo>
