<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_season_view_list" model="ir.ui.view">
        <field name="name">cl.rice.season.view.list</field>
        <field name="model">cl.rice.season</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="reference_price"/>
                <field name="farmer_count"/>
                <field name="acreage"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planning'"
                       decoration-success="state in ('active', 'harvest')"
                       decoration-warning="state == 'closing'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cl_rice_season_view_form" model="ir.ui.view">
        <field name="name">cl.rice.season.view.form</field>
        <field name="model">cl.rice.season</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state != 'planning'" groups="cl_rice_mill.cl_rice_mill_group_manager"/>
                    <button name="action_harvest" type="object" string="Start Harvest" class="btn-primary"
                            invisible="state != 'active'" groups="cl_rice_mill.cl_rice_mill_group_manager"/>
                    <button name="action_closing" type="object" string="Start Closing"
                            invisible="state != 'harvest'" groups="cl_rice_mill.cl_rice_mill_group_manager"/>
                    <button name="action_close" type="object" string="Close Season"
                            invisible="state != 'closing'" groups="cl_rice_mill.cl_rice_mill_group_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_farmer_seasons" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="farmer_count" widget="statinfo" string="Farmers"/>
                        </button>
                        <button name="action_open_project" type="object" class="oe_stat_button" icon="fa-puzzle-piece"
                                invisible="not project_id" string="Project"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Msimu 2026/27"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="reference_price"/>
                            <field name="rice_reference_price"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Key Figures" name="kpis">
                        <group>
                            <field name="acreage"/>
                        </group>
                        <group>
                            <field name="credit_limit_total"/>
                        </group>
                    </group>
                    <group string="Links" name="links" groups="base.group_no_one">
                        <field name="project_id"/>
                        <field name="analytic_plan_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cl_rice_season_view_search" model="ir.ui.view">
        <field name="name">cl.rice.season.view.search</field>
        <field name="model">cl.rice.season</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="open" string="Open" domain="[('state', '!=', 'closed')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="cl_rice_season_action" model="ir.actions.act_window">
        <field name="name">Seasons</field>
        <field name="res_model">cl.rice.season</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first season (msimu)</p>
            <p>A season groups everything that happens with each farmer from land preparation to settlement.</p>
        </field>
    </record>
</odoo>
