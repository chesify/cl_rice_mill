<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_dashboard_action" model="ir.actions.client">
        <field name="name">Rice Mill Dashboard</field>
        <field name="tag">cl_rice_mill.dashboard</field>
    </record>

    <!-- standard analysis views, to slice beyond the dashboard -->
    <record id="cl_rice_analysis_income_action" model="ir.actions.server">
        <field name="name">Income by Service Line</field>
        <field name="model_id" ref="model_cl_rice_season"/>
        <field name="state">code</field>
        <field name="code">action = env['cl.rice.dashboard'].action_open_analysis('income')</field>
    </record>
    <record id="cl_rice_analysis_machines_action" model="ir.actions.server">
        <field name="name">Profit per Machine</field>
        <field name="model_id" ref="model_cl_rice_season"/>
        <field name="state">code</field>
        <field name="code">action = env['cl.rice.dashboard'].action_open_analysis('machines')</field>
    </record>
    <record id="cl_rice_analysis_ageing_action" model="ir.actions.server">
        <field name="name">Farmer Ageing</field>
        <field name="model_id" ref="model_cl_rice_season"/>
        <field name="state">code</field>
        <field name="code">action = env['cl.rice.dashboard'].action_open_analysis('ageing')</field>
    </record>
    <record id="cl_rice_analysis_stock_action" model="ir.actions.server">
        <field name="name">Stock per Farmer and Lot</field>
        <field name="model_id" ref="model_cl_rice_season"/>
        <field name="state">code</field>
        <field name="code">action = env['cl.rice.dashboard'].action_open_analysis('stock')</field>
    </record>
    <record id="cl_rice_analysis_milling_action" model="ir.actions.server">
        <field name="name">Milling Yield</field>
        <field name="model_id" ref="model_cl_rice_season"/>
        <field name="state">code</field>
        <field name="code">action = env['cl.rice.dashboard'].action_open_analysis('milling')</field>
    </record>
    <record id="cl_rice_analysis_pnl_action" model="ir.actions.server">
        <field name="name">Season Profit and Loss</field>
        <field name="model_id" ref="model_cl_rice_season"/>
        <field name="state">code</field>
        <field name="code">action = env['cl.rice.dashboard'].action_open_analysis('pnl')</field>
    </record>
</odoo>
