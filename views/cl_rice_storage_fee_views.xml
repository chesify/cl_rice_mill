<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_storage_fee_view_list" model="ir.ui.view">
        <field name="name">cl.rice.storage.fee.view.list</field>
        <field name="model">cl.rice.storage.fee</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="name"/>
                <field name="period"/>
                <field name="partner_id"/>
                <field name="lot_id"/>
                <field name="product_id" optional="hide"/>
                <field name="basis"/>
                <field name="quantity"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="rate"/>
                <field name="amount" sum="Total"/>
                <field name="invoice_id" groups="cl_rice_mill.cl_rice_mill_group_accountant"/>
            </list>
        </field>
    </record>

    <record id="cl_rice_storage_fee_view_search" model="ir.ui.view">
        <field name="name">cl.rice.storage.fee.view.search</field>
        <field name="model">cl.rice.storage.fee</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="lot_id"/>
                <field name="period"/>
                <group>
                    <filter name="group_period" string="Month" context="{'group_by': 'period'}"/>
                    <filter name="group_partner" string="Owner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cl_rice_storage_fee_action" model="ir.actions.act_window">
        <field name="name">Storage Fees</field>
        <field name="res_model">cl.rice.storage.fee</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No storage fee charged yet</p>
            <p>Storage fees are charged every month on farmer stock kept beyond the free period.</p>
        </field>
    </record>
</odoo>
