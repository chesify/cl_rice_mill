<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_farmer_season_view_list" model="ir.ui.view">
        <field name="name">cl.rice.farmer.season.view.list</field>
        <field name="model">cl.rice.farmer.season</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="farmer_code" optional="show"/>
                <field name="partner_id"/>
                <field name="season_id"/>
                <field name="field_officer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="acreage" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="credit_limit"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state in ('active', 'harvested', 'in_storage')"
                       decoration-warning="state == 'released'"
                       decoration-muted="state in ('settled', 'closed')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cl_rice_farmer_season_view_form" model="ir.ui.view">
        <field name="name">cl.rice.farmer.season.view.form</field>
        <field name="model">cl.rice.farmer.season</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_give_loan" type="object" string="Give Loan" class="btn-primary"
                            invisible="is_locked or state == 'draft'"/>
                    <button name="action_record_service" type="object" string="Record Service"
                            invisible="is_locked or state == 'draft'"/>
                    <button name="action_receive_payment" type="object" string="Receive Payment"
                            invisible="is_locked or state == 'draft'" groups="cl_rice_mill.cl_rice_mill_group_accountant"/>
                    <button name="action_release_stock" type="object" string="Release Stock"
                            invisible="state not in ('harvested', 'in_storage', 'released')"
                            groups="cl_rice_mill.cl_rice_mill_group_warehouse,cl_rice_mill.cl_rice_mill_group_accountant"/>
                    <button name="action_open_settle" type="object" string="Pay Farmer"
                            invisible="state not in ('released', 'in_storage', 'harvested', 'active')"
                            groups="cl_rice_mill.cl_rice_mill_group_accountant"/>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_harvested" type="object" string="Mark Harvested"
                            invisible="state != 'active'"/>
                    <button name="action_open_credit_override" type="object" string="Override Credit Limit"
                            invisible="is_locked" groups="cl_rice_mill.cl_rice_mill_group_manager"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'settled'" groups="cl_rice_mill.cl_rice_mill_group_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,harvested,in_storage,released,settled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="loan_count" widget="statinfo" string="Loans"/>
                        </button>
                        <button name="action_view_service_jobs" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="service_job_count" widget="statinfo" string="Services"/>
                        </button>
                        <button name="action_view_intakes" type="object" class="oe_stat_button" icon="fa-download">
                            <field name="intake_count" widget="statinfo" string="Intakes"/>
                        </button>
                        <button name="action_view_milling_jobs" type="object" class="oe_stat_button" icon="fa-cogs">
                            <field name="milling_count" widget="statinfo" string="Milling"/>
                        </button>
                        <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-handshake-o">
                            <field name="sale_count" widget="statinfo" string="Sales"/>
                        </button>
                        <button name="action_view_settlements" type="object" class="oe_stat_button" icon="fa-balance-scale"
                                invisible="not settlement_count">
                            <field name="settlement_count" widget="statinfo" string="Settlements"/>
                        </button>
                        <button name="action_view_journal_items" type="object" class="oe_stat_button" icon="fa-book"
                                string="Account" groups="account.group_account_readonly"/>
                    </div>
                    <widget name="web_ribbon" title="Locked" bg_color="text-bg-secondary" invisible="not is_locked"/>
                    <div class="alert alert-danger mb-2" role="alert" invisible="not over_limit">
                        The farmer's exposure is above the credit limit.
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not low_cover">
                        The stock held covers too little of what the farmer owes.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Farmer" name="farmer">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="farmer_code"/>
                            <field name="season_id" readonly="state != 'draft'"/>
                            <field name="field_officer_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="is_locked" invisible="1"/>
                        </group>
                        <group string="Farm" name="farm">
                            <field name="acreage" readonly="is_locked"/>
                            <field name="expected_yield" readonly="is_locked"/>
                            <field name="expected_production"/>
                        </group>
                    </group>
                    <group string="Balance" name="balance">
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="balance_owed" class="fw-bold" decoration-danger="balance_owed &gt; 0"/>
                            <field name="funds_held"/>
                            <field name="net_balance" class="fw-bold"
                                   decoration-danger="net_balance &lt; 0" decoration-success="net_balance &gt; 0"/>
                        </group>
                        <group>
                            <field name="credit_limit"/>
                            <field name="exposure"/>
                            <field name="over_limit" invisible="1"/>
                        </group>
                    </group>
                    <group string="Stock Held" name="stock">
                        <group>
                            <label for="paddy_kg"/>
                            <div class="o_row">
                                <field name="paddy_kg"/> kg / <field name="paddy_bags"/> bags
                            </div>
                            <label for="rice_kg"/>
                            <div class="o_row">
                                <field name="rice_kg"/> kg / <field name="rice_bags"/> bags
                            </div>
                        </group>
                        <group>
                            <field name="collateral_value"/>
                            <field name="collateral_cover" decoration-danger="low_cover"/>
                            <field name="low_cover" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Charges" name="charges">
                            <group>
                                <group>
                                    <field name="opening_total" invisible="not opening_total"/>
                                    <field name="loan_total"/>
                                    <field name="service_total"/>
                                    <field name="operator_total"/>
                                    <field name="milling_total"/>
                                    <field name="storage_total"/>
                                    <field name="charges_total" class="fw-bold"/>
                                    <field name="paid_total"/>
                                </group>
                            </group>
                        </page>
                        <page string="Loans" name="loans">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="loan_type"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Services" name="services">
                            <field name="service_job_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="service_type"/>
                                    <field name="quantity"/>
                                    <field name="uom"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="operator_paid_amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Intakes" name="intakes">
                            <field name="intake_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="bags" sum="Total"/>
                                    <field name="net_weight" sum="Total"/>
                                    <field name="moisture"/>
                                    <field name="grade"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Milling" name="milling">
                            <field name="milling_job_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="input_kg" sum="Total"/>
                                    <field name="rice_kg" sum="Total"/>
                                    <field name="recovery_pct"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="fee_amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sales and Releases" name="sales">
                            <field name="facilitated_sale_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="buyer_id"/>
                                    <field name="product_id"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="released_qty" sum="Total"/>
                                    <field name="payment_route"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payments" name="payments">
                            <field name="payment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="payment_type"/>
                                    <field name="payer_id"/>
                                    <field name="journal_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Storage Fees" name="storage">
                            <field name="storage_fee_ids" readonly="1">
                                <list>
                                    <field name="period"/>
                                    <field name="lot_id"/>
                                    <field name="quantity"/>
                                    <field name="basis"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Credit" name="credit">
                            <group>
                                <group>
                                    <field name="reference_price"/>
                                    <field name="credit_limit_computed"/>
                                </group>
                                <group invisible="not credit_limit_override">
                                    <field name="credit_limit_override"/>
                                    <field name="credit_limit_override_uid"/>
                                    <field name="credit_limit_override_reason"/>
                                </group>
                            </group>
                        </page>
                        <page string="Plots" name="plots">
                            <field name="plot_details" placeholder="Plot names, location, soil, irrigation..." readonly="is_locked"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                        <page string="Links" name="links" groups="base.group_no_one">
                            <group>
                                <field name="analytic_account_id"/>
                                <field name="task_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cl_rice_farmer_season_view_search" model="ir.ui.view">
        <field name="name">cl.rice.farmer.season.view.search</field>
        <field name="model">cl.rice.farmer.season</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="farmer_code"/>
                <field name="season_id"/>
                <field name="field_officer_id"/>
                <filter name="my" string="My Farmers" domain="[('field_officer_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state', 'not in', ('settled', 'closed'))]"/>
                <filter name="settled" string="Settled" domain="[('state', 'in', ('settled', 'closed'))]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_season" string="Season" context="{'group_by': 'season_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_officer" string="Field Officer" context="{'group_by': 'field_officer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cl_rice_farmer_season_action" model="ir.actions.act_window">
        <field name="name">Farmer Seasons</field>
        <field name="res_model">cl.rice.farmer.season</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a farmer for the season</p>
            <p>The farmer season holds every loan, service, intake, milling, release, payment and the settlement of one farmer for one season.</p>
        </field>
    </record>
</odoo>
