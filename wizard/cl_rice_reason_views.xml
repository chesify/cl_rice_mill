<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_reason_view_form" model="ir.ui.view">
        <field name="name">cl.rice.reason.view.form</field>
        <field name="model">cl.rice.reason</field>
        <field name="arch" type="xml">
            <form>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="action" invisible="1"/>
                <group>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount" invisible="not show_amount" required="show_amount"/>
                    <field name="reason" placeholder="Explain why (it is recorded in the history)"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
