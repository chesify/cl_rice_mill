<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_settlement_create_view_form" model="ir.ui.view">
        <field name="name">cl.rice.settlement.create.view.form</field>
        <field name="model">cl.rice.settlement.create</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="farmer_season_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="date"/>
                    <field name="settlement_type" widget="radio"/>
                    <field name="stock_held_kg" invisible="stock_held_kg &lt;= 0"/>
                    <field name="negative_policy" widget="radio" invisible="settlement_type != 'final'"/>
                    <field name="next_season_id" invisible="settlement_type != 'final' or negative_policy != 'carry_forward'"/>
                    <field name="payout_journal_id"/>
                </group>
                <group string="Money Held" invisible="settlement_type != 'interim'">
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="funds_held"/>
                        <field name="balance_owed"/>
                        <field name="payout_amount"/>
                        <field name="applied_amount"/>
                    </group>
                    <group>
                        <field name="kept_amount" invisible="not kept_amount"/>
                        <field name="owed_after" decoration-danger="owed_after &gt; 0"/>
                        <field name="cover_after" invisible="not owed_after"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="settlement_type != 'interim' or not needs_debt_approval">
                    The farmer still owes money after this payout: a Rice Mill Manager must approve it with a reason
                    before it is paid.
                </div>
                <p class="text-muted">
                    Everything the farmer owes and everything due to the farmer for the season is listed.
                    Review the statement before confirming it.
                </p>
                <footer>
                    <button name="action_create" type="object" string="Prepare Statement" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
