<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cl_rice_statement_print_view_form" model="ir.ui.view">
        <field name="name">cl.rice.statement.print.view.form</field>
        <field name="model">cl.rice.statement.print</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="farmer_season_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="cl_rice_statement_print_action" model="ir.actions.act_window">
        <field name="name">Farmer Account Statement</field>
        <field name="res_model">cl.rice.statement.print</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
